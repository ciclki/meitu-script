#!name=美图欣赏
#!desc=多看美图助于身心健康😊（图源域名已更换为 001.xx.kg）

[Script]
meitu = type=http-request, pattern=^https?:\/\/001\.xx\.kg, script-path=https://raw.githubusercontent.com/ciclki/meitu-script/main/meitu.js, requires-body=true, max-size=-1, timeout=60

美图鉴赏 = type=cron, cronexp="30 20 * * *", script-path=https://raw.githubusercontent.com/ciclki/meitu-script/main/meitu.js, timeout=120, wake-system=1

[MITM]
hostname = %APPEND% 001.xx.kg
