#!name=美图欣赏 (Surge)
#!desc=多看美图助于身心健康😊（图源域名 001.xx.kg，适配 Surge）

[Script]
美图拦截 = type=http-request, pattern=^https?:\/\/001\.xx\.kg, script-path=https://raw.githubusercontent.com/ciclki/meitu-script/main/meitu.js, requires-body=false, timeout=60

美图鉴赏 = type=cron, cronexp="30 20 * * *", script-path=https://raw.githubusercontent.com/ciclki/meitu-script/main/meitu.js, timeout=120, wake-system=true

[MITM]
hostname = %APPEND% 001.xx.kg
